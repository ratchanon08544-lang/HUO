--[ ฟังก์ชัน 1: ล็อกหน้าจอนิ่ง / ลดการสั่น ]--
CreateToggleOption("ล็อกหน้าจอนิ่ง / ลดการสั่น (Anti-Shake)", "ป้องกันหน้าจอสั่นเวลาโดนระเบิด/เอฟเฟค", function(state)
    if state then
        _G.ShakeConnection = RunService.RenderStepped:Connect(function()
            pcall(function()
                if Camera then
                    for _, v in pairs(Camera:GetChildren()) do
                        if v:IsA("CameraShakeInstance") or v.Name:lower():find("shake") then
                            v:Destroy()
                        end
                    end
                end
            end)
        end)
    else
        if _G.ShakeConnection then _G.ShakeConnection:Disconnect() _G.ShakeConnection = nil end
    end
end)

--[ ฟังก์ชัน 2: โหมดดินน้ำมัน (Smooth Plastic) - แบบไม่หน่วง ]--
CreateToggleOption("โหมดดินน้ำมัน (Smooth Plastic)", "เปลี่ยนพื้นผิววัตถุรอบตัวครั้งเดียวเพื่อเพิ่ม FPS", function(state)
    if state then
        task.spawn(function()
            for _, v in pairs(Workspace:GetDescendants()) do
                if (v:IsA("BasePart") or v:IsA("MeshPart")) and not v:IsDescendantOf(LocalPlayer.Character) then
                    v.Material = Enum.Material.SmoothPlastic
                end
            end
        end)
    else
        game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
    end
end)

