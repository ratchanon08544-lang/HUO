-- อัปเดตค่า FPS และ Ping แบบเรียลไทม์ (ปรับลดความถี่เพื่อไม่ให้กินเครื่อง)
local lastUpdate = 0
local frameCount = 0
local currentFPS = 60

RunService.RenderStepped:Connect(function(dt)
    frameCount = frameCount + 1
    local now = tick()
    if now - lastUpdate >= 1.0 then -- อัปเดตทุกๆ 1 วินาทีแทน เพื่อลดภาระ
        currentFPS = math.floor(frameCount / (now - lastUpdate))
        frameCount = 0
        lastUpdate = now
    end
    
    local pingValue = 0
    pcall(function()
        pingValue = math.floor(LocalPlayer:GetNetworkPing() * 1000)
    end)
    
    StatsLabel.Text = "FPS: " .. currentFPS .. " | Ping: " .. pingValue .. "ms"
end)

