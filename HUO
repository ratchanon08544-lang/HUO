--[ ฟังก์ชัน 4: ลบต้นไม้และใบไม้ ]--
CreateToggleOption("ลบต้นไม้และใบไม้ (Remove Trees)", "ลบต้นไม้และพุ่มไม้ออกเพื่อเพิ่ม FPS มหาศาล", function(state)
    local function checkAndRemove(obj)
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = string.lower(obj.Name)
            if name:find("tree") or name:find("plant") or name:find("bush") or name:find("leaf") or name:find("leaves") then
                obj:Destroy()
            end
        end
    end

    if state then
        task.spawn(function()
            for _, v in pairs(Workspace:GetDescendants()) do
                checkAndRemove(v)
            end
        end)
        _G.TreeTracker = Workspace.DescendantAdded:Connect(function(v)
            task.spawn(function() checkAndRemove(v) end)
        end)
    else
        if _G.TreeTracker then _G.TreeTracker:Disconnect() _G.TreeTracker = nil end
        game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
    end
end)

--[ ฟังก์ชัน 5: ตัวละครสีเทา ]--
CreateToggleOption("ตัวละครสีเทา (Gray Characters)", "บังคับเปลี่ยนสีตัวละครผู้เล่นอื่นให้เป็นสีเทา", function(state)
    local function makeGrayChar(char)
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("MeshPart") then
                part.Material = Enum.Material.SmoothPlastic
                part.Color = Color3.fromRGB(120, 120, 120)
            elseif part:IsA("Clothing") or part:IsA("ShirtGraphic") then
                part:Destroy()
            end
        end
    end

    if state then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then makeGrayChar(p.Character) end
            p.CharacterAdded:Connect(function(char)
                task.wait(0.5)
                makeGrayChar(char)
            end)
        end
    else
        game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
    end
end)

--[ ฟังก์ชัน 6: ลบเงาและลดแสง ]--
CreateToggleOption("ลบเงาและลดแสง (No Shadows & Optimize)", "ปิดเงาและปรับแสงให้สว่างโล่งเพื่อเพิ่ม FPS", function(state)
    if state then
        Lighting.GlobalShadows = false
        Lighting.Brightness = 1.5
        Lighting.FogEnd = 999999
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
                v.Enabled = false
            end
        end
    else
        Lighting.GlobalShadows = true
        Lighting.Brightness = 2
    end
end)

